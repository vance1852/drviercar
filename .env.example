# drviercar runtime configuration. Copy to .env and adjust locally.
# Never commit real credentials.
DRVIERCAR_ADDR=127.0.0.1:8080
DRVIERCAR_DB_PATH=data/drviercar.sqlite
DRVIERCAR_LOG_LEVEL=info
DRVIERCAR_SESSION_TTL=8h
DRVIERCAR_REQUEST_TIMEOUT=15s
DRVIERCAR_SHUTDOWN_TIMEOUT=10s
DRVIERCAR_WORKER_INTERVAL=1s
DRVIERCAR_WORKER_BATCH=5
DRVIERCAR_WORKER_BACKOFF=2s
DRVIERCAR_DB_MAX_CONNS=4
DRVIERCAR_BOOTSTRAP_ADMIN=fleet-admin
DRVIERCAR_BOOTSTRAP_SECRET=replace-with-a-real-secret
